# Frontend env vars. Copy to .env.local (gitignored) for local dev; set in
# Vercel (Project → Settings → Environment Variables) for production.

# Clerk (dashboard → API Keys). Restricted mode is a dashboard setting:
# Configure → Restrictions → Sign-up mode → Restricted.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Sign-up deliberately routes to sign-in: no public signups.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-in

# FastAPI base URL (local: http://localhost:8000, prod: the Render URL).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
