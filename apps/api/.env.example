# API env vars. Copy to .env (gitignored) for local dev; set in Render
# (Environment tab) for production.

# ---------- Postgres (Neon) ----------
# Use the DIRECT endpoint (no "-pooler" in the host) with sslmode=require.
# postgres:// or postgresql:// schemes both work; the app normalises them.
# Example: postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/maths?sslmode=require
DATABASE_URL=

# ---------- Clerk JWT verification ----------
# Clerk Frontend API URL (no trailing slash). Clerk dashboard → API Keys →
# "Show API URLs" → Frontend API. e.g. https://<slug>.clerk.accounts.dev
CLERK_JWT_ISSUER=

# Optional: enforce the `aud` claim. Leave unset for default Clerk session
# tokens (they don't carry an aud).
# CLERK_AUDIENCE=

# Set to 1 to skip JWT verification entirely. Local dev only — never in prod.
# With auth disabled, the X-Dev-User-Id header selects the acting parent.
# CLERK_AUTH_DISABLED=1

# Comma-separated Clerk user IDs allowed on /admin/* (find yours in the
# Clerk dashboard → Users → your user → User ID, starts with "user_").
ADMIN_CLERK_USER_IDS=

# ---------- CORS ----------
# Comma-separated origins. Production must include the Vercel URL.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------- Internal (Lambda -> API) HMAC ----------
# Shared secret for X-Internal-Signature on /internal/* endpoints. Generate:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Must match the value the CDK stacks bake into the Lambdas.
INTERNAL_HMAC_SECRET=

# ---------- Photo uploads (S3) ----------
# Bucket name output by the CDK UploadPipelineStack (maths-uploads stack).
S3_UPLOAD_BUCKET=
AWS_REGION=ap-southeast-1
# Presigned PUT URL lifetime in seconds.
UPLOAD_URL_TTL_SECONDS=300

APP_VERSION=0.1.0
